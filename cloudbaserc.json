{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.1",
  "envId": "{{env.ENV_ID}}",
  "region": "ap-singapore",
  "functionRoot": "functions",
  "functions": [
    {
      "name": "hello",
      "type": "Event",
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "http-demo",
      "type": "HTTP",
      "buildStrategy": "zip",
      "runtime": "Nodejs18.15"
    }
  ]
}
