{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.1",

  "envId": "{{env.ENV_ID}}",
  "functionRoot": "functions",
  "functions": [
    {
      "name": "hello",
      "type": "Event",
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "http-demo",
      "type": "HTTP",
      "buildStrategy": "zip",
      "runtime": "Nodejs18.15"
    }
  ],
  "hosting": [
    {
      "name": "web",
      "root": "site",
      "framework": "static",
      "deployPath": "/"
    },    {
      "name": "web02",
      "root": "site",
      "framework": "static",
      "deployPath": "/web02"
    }
  ],
  "gateway": {
    "routes": [
      {
        "path": "/api-demo",
        "target": "function:hello"
      },
      {
        "path": "/api-http",
        "target": "function:http-demo"
      },
      {
        "path": "/web",
        "target": "hosting:web"
      }
    ]
  },
  "database": {
    "type": "postgresql",
    "migrations": "./cloudbase/migrations"
  }
}
